#include <windows.h>
#include "../src/resource.h"
IDI_APP ICON "nightfall.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "nightfall.manifest"
VS_VERSION_INFO VERSIONINFO
#ifndef NF_VERSION_COMMA
#define NF_VERSION_COMMA 0,0,0,0
#define NF_VERSION_STR "0.0.0"
#endif
FILEVERSION NF_VERSION_COMMA
PRODUCTVERSION NF_VERSION_COMMA
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Nightfall screen blanker"
      VALUE "ProductName", "Nightfall"
      VALUE "FileVersion", NF_VERSION_STR
      VALUE "ProductVersion", NF_VERSION_STR
      VALUE "OriginalFilename", "nightfall.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
